# Copy to .env and fill in your own values, then:
#   export $(grep CLOUDINARY_URL .env)
#
# Find these under Console > Settings > API Keys, or provision a throwaway
# product environment with `npx @cloudinary/cloud`. See docs/get-credentials.md.
#
# .env is gitignored — never commit real credentials.
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
